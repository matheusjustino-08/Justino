// Justino Native Enterprise Desktop Application (.jucode)

struct UserRecord {
    id: int,
    username: string,
    email: string,
    balance: int
}

struct AppConfig {
    app_name: string,
    port: int,
    db_file: string
}

fn load_configuration() -> AppConfig {
    return AppConfig {
        app_name: "Justino Enterprise Desktop App",
        port: 8080,
        db_file: "app_data.db"
    };
}

fn create_user(user_id: int, name: string) -> UserRecord {
    return UserRecord {
        id: user_id,
        username: name,
        email: "${name}@justino.org",
        balance: 1250
    };
}

fn main() -> int {
    let config = load_configuration();
    let user = create_user(1, "Alice Developer");
    let welcome_msg = "Welcome to ${config.app_name}! Active User: ${user.username}";
    return user.balance; // Returns 1250
}

return main();
