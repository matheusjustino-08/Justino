// Exemplo de código na linguagem Justino (.jucode)

struct Usuario {
    nome: string,
    pontos: int
}

fn calcular_bonus(u: Usuario, fator: int) -> int {
    let mut total = u.pontos * fator;
    if total > 100 {
        total = total + 50;
    }
    return total;
}

fn main() -> int {
    let mut dev = Usuario {
        nome: "Matheus",
        pontos: 30
    };

    let bonus = calcular_bonus(dev, 4); // 30 * 4 = 120 -> 120 + 50 = 170
    return bonus;
}

return main();
