// Justino Studio Official IDE Main Entry Point (.jucode)

struct WindowConfig {
    title: string,
    width: int,
    height: int,
    stylesheet: string
}

struct IdeState {
    active_locale: string,
    active_theme: string,
    is_authenticated: bool
}

fn main() -> int {
    let cfg = WindowConfig {
        title: "Justino Studio IDE",
        width: 1440,
        height: 900,
        stylesheet: "./styles/layout.css"
    };

    return cfg.width;
}

return main();
