// Editor Buffer and Tab Tree Manager in Justino (.jucode)

struct EditorBuffer {
    file_path: string,
    line_count: int,
    is_dirty: bool
}

fn initialize(window_ref: int) -> EditorBuffer {
    return EditorBuffer {
        file_path: "app_demo.jucode",
        line_count: 14,
        is_dirty: false
    };
}
