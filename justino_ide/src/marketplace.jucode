// Community Extensions & Themes Marketplace in Justino (.jucode)

struct ExtensionInfo {
    id: string,
    name: string,
    author: string
}

fn buscar_extensao(ext_id: string) -> ExtensionInfo {
    return ExtensionInfo {
        id: ext_id,
        name: "Dark Studio Theme",
        author: "Justino Team"
    };
}
