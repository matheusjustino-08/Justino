// Onboarding & Login Module in Justino (.jucode)

struct UserSession {
    user_id: string,
    username: string,
    jwt_token: string
}

fn autenticar_oauth2(username: string) -> UserSession {
    let user_id = "user_101";
    let token = "JUSTINO_JWT_SESSION_TOKEN_2026";
    return UserSession {
        user_id: user_id,
        username: username,
        jwt_token: token
    };
}

fn aplicar_tema(theme_path: string) -> string {
    return "Applied theme: ${theme_path}";
}

fn iniciar(username: string, theme: string) -> UserSession {
    let session = autenticar_oauth2(username);
    let msg = aplicar_tema(theme);
    return session;
}
