// Justino Source Code (.jucode) for Native Executable Compilation

struct Calculator {
    base: int
}

fn multiply_and_add(calc: Calculator, factor: int, term: int) -> int {
    let mut result = calc.base * factor;
    let mut i = 1;
    while i <= term {
        result = result + i;
        i = i + 1;
    }
    return result;
}

fn main() -> int {
    let c = Calculator { base: 10 };
    // 10 * 5 = 50 + (1 + 2 + 3 + 4) = 50 + 10 = 60
    let res = multiply_and_add(c, 5, 4);
    let msg = "Justino native executable (.exe) running: ${res}";
    return res;
}

return main();
